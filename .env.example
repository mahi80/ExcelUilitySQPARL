# Copy to .env and fill in real values. .env is gitignored.
# Rotate any key that leaks into chat, version control, or logs.

# === Anthropic Claude API ===
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL=claude-opus-4-7

# === Postgres ===
POSTGRES_USER=excelutil
POSTGRES_PASSWORD=change_me_in_real_env
POSTGRES_DB=excelutil
POSTGRES_PORT=5432

# Owner DSN — used by the onboarding service for DDL + load (inside docker network).
POSTGRES_DSN=postgresql://excelutil:change_me_in_real_env@postgres:5432/excelutil

# Read-only login user for the agent's query sandbox. Created IN ROLE app_ro
# (the NOLOGIN group from 01_roles.sql) so it inherits per-dataset SELECT grants.
POSTGRES_RO_USER=app_ro_user
POSTGRES_RO_PASSWORD=change_me_in_real_env_ro
POSTGRES_RO_DSN=postgresql://app_ro_user:change_me_in_real_env_ro@postgres:5432/excelutil
# The NOLOGIN group role the onboarding service grants dataset SELECT to.
POSTGRES_RO_GROUP=app_ro

# Multi-project (M2): each dataset is an isolated schema ds_<id> tracked in
# meta.project. Optionally pin a default project id the agent serves when a
# request omits one (otherwise it uses the newest 'ready' project).
DEFAULT_PROJECT=

# === Redis ===
REDIS_URL=redis://redis:6379/0
REDIS_PORT=127.0.0.1:6379

# === Agent ===
AGENT_PORT=8000
CONFIDENCE_THRESHOLD=0.7
MAX_REPAIR_ATTEMPTS=2
TOKEN_BUDGET_PER_QUERY=8000

# === Onboarding ===
ONBOARDING_PORT=8001

# === Ontop (SPARQL via OBDA over Postgres) ===
ONTOP_PORT=8090
ONTOP_SPARQL_ENDPOINT=http://ontop:8080/sparql

# === OpenMetadata catalog (Phase-2, opt-in) ===
# Runs as its own stack (catalog/openmetadata.yml). When OPENMETADATA_HOST is set,
# onboarding pushes each dataset's schema to the catalog. Leave blank to disable.
# From the onboarding container, reach the separate OM stack via host-gateway:
OPENMETADATA_HOST=
# e.g. OPENMETADATA_HOST=http://host.docker.internal:8585
OPENMETADATA_ADMIN_EMAIL=admin@open-metadata.org
OPENMETADATA_ADMIN_PASSWORD=admin
OPENMETADATA_JWT_TOKEN=

# === UI ===
UI_PORT=8080
AGENT_URL=http://agent:8000
ONBOARDING_URL=http://onboarding:8001
# Single shared login for the POC (M2+ adds per-user accounts / SSO).
UI_AUTH_USER=admin
UI_AUTH_PASSWORD=change_me
# Session cookie signing secret. Generate with: openssl rand -hex 32
UI_SESSION_SECRET=change_me_to_a_long_random_hex_string
